   "avg_logprob": -0.1542,
   "compression_ratio": 1.847,
   "no_speech_prob": 0.0
  },
  {
   "id": 8,
   "start": 31.17,
   "end": 55.12,
   "text": " Oke, sebelum kita ke Unified Modeling Language, ada baiknya kita tahu apa yang dimaksud dengan Object-Oriented Analysis dan Design.",
   "temperature": 0.0,
   "avg_logprob": -0.1507,
   "compression_ratio": 1.674,
   "no_speech_prob": 0.0
  },
  {
   "id": 9,
   "start": 55.36,
   "end": 63.04,
   "text": " Pada video-video saya sebelumnya, saya sudah menjelaskan Analisis dan Design System itu berdasarkan pemrograman terstruktur.",
   "temperature": 0.0,
   "avg_logprob": -0.1507,
